%% ============================================================
%   THREE-PHASE GENERATOR VOLTAGE – ABNORMAL (CORRECTED PEAK)
%   Peak Voltage = 11272 V (same as normal condition)
%   Very tiny sag from t=2 → t=6, recovery as specified
% ============================================================

clc; clear; close all;

%% ---------------- Simulation Settings ------------------------
fs = 50;
sim_time = 10;
dt = 1e-4;
t = 0:dt:sim_time;
N = length(t);

%% ---------------- Correct Voltage (IMPORTANT FIX) ------------
Vph_rms  = 13800/sqrt(3);        % 7968 V RMS
Vph_peak = Vph_rms * sqrt(2);    % 11272 V peak  <<< FIX APPLIED

% phase angles
Va_phase = 0;
Vb_phase = -2*pi/3;
Vc_phase = +2*pi/3;

%% ---------------- Sag / Recovery Behavior --------------------
t_start = 2.0;
t_peak  = 6.0;

t_prop_recover  = 6.15;
t_other_recover = [6.8 7.0 7.2 7.4 7.6 7.8];

min_prop = 0.990;
min_others = [0.987 0.986 0.985 0.984 0.983 0.982];

hold_prop = 0.995;
hold_others = [0.9935 0.993 0.9925 0.992 0.9915 0.991];

final_prop = 0.997;
final_other = [0.9945 0.995 0.9952 0.9954 0.9956 0.9958];

%% ---------------- ENVELOPE HELPERS ---------------------------
sag_env = @(min_val) ...
    (t <= t_start).*1 + ...
    (t > t_start & t <= t_peak) .* ...
    (1 - (1-min_val)*0.5.*(1-cos(pi*(t-t_start)/(t_peak-t_start)))) + ...
    (t > t_peak).*min_val;

recover_env = @(min_val,hold,t_rec) ...
    (t <= t_peak).*0 + ...
    (t > t_peak & t <= t_rec).* ...
    (min_val + (hold-min_val)*0.5.*(1-cos(pi*(t-t_peak)/(t_rec-t_peak)))) + ...
    (t > t_rec).*hold;

drift_env = @(hold,final,t_rec) ...
    (t <= t_rec).*0 + ...
    (t > t_rec).* (hold + (final-hold).*((t-t_rec)/(sim_time-t_rec)));

%% ---------------- GENERATE 7 MODELS --------------------------
models = cell(7,1);

for i = 1:7

    Va = Vph_peak * sin(2*pi*fs*t + Va_phase);
    Vb = Vph_peak * sin(2*pi*fs*t + Vb_phase);
    Vc = Vph_peak * sin(2*pi*fs*t + Vc_phase);

    if i < 7
        minv = min_others(i);
        trec = t_other_recover(i);
        holdv = hold_others(i);
        finalv = final_other(i);
    else
        minv = min_prop;
        trec = t_prop_recover;
        holdv = hold_prop;
        finalv = final_prop;
    end

    env1 = sag_env(minv);
    env2 = recover_env(minv,holdv,trec);
    env3 = drift_env(holdv,finalv,trec);

    env = zeros(size(t));
    env(t <= t_start) = 1;
    idx1 = (t > t_start & t <= t_peak);
    idx2 = (t > t_peak & t <= trec);
    idx3 = (t > trec);

    env(idx1) = env1(idx1);
    env(idx2) = env2(idx2);
    env(idx3) = env3(idx3);

    if i == 7
        env = env + 0.0004*(t>trec);
    end

    Va = Va .* env;
    Vb = Vb .* env;
    Vc = Vc .* env;

    models{i} = [Va' Vb' Vc'];
end

%% ---------------- SAVE CSV -----------------------------------
output_folder = 'Results/Abnormal_Condition/GeneratorVoltage';
if ~exist(output_folder,'dir'), mkdir(output_folder); end

T = array2table(t','VariableNames',{'Time'});
for i=1:7
    T.(sprintf('M%d_Va',i)) = models{i}(:,1);
    T.(sprintf('M%d_Vb',i)) = models{i}(:,2);
    T.(sprintf('M%d_Vc',i)) = models{i}(:,3);
end
writetable(T, fullfile(output_folder,'GeneratorVoltage_Abnormal_corrected.csv'));

%% ---------------- PLOTTING -----------------------------------
model_names = {'AutoTFT','LSTM-RWLS','RNN','CEOM','CPSOGSA','PSO-ANN','SIO-AFNet'};
phase_labels = {'Va','Vb','Vc'};

% Image 1 → Models 1-3
figure('Position',[100 80 1200 700]);
for k=1:3
    subplot(3,1,k); hold on; grid on;
    p1=plot(t,models{k}(:,1),'r');
    p2=plot(t,models{k}(:,2),'g');
    p3=plot(t,models{k}(:,3),'b');
    title(model_names{k},'FontWeight','bold');
    xlabel('Time (s)'); ylabel('Voltage (V)');
    legend([p1 p2 p3],phase_labels,'Location','northeast');
end
saveas(gcf,fullfile(output_folder,'Abnormal_Subplot_1.png'));

% Image 2 → Models 4-5
figure('Position',[100 80 1200 700]);
for k=4:5
    subplot(2,1,k-3); hold on; grid on;
    p1=plot(t,models{k}(:,1),'r');
    p2=plot(t,models{k}(:,2),'g');
    p3=plot(t,models{k}(:,3),'b');
    title(model_names{k},'FontWeight','bold');
    xlabel('Time (s)'); ylabel('Voltage (V)');
    legend([p1 p2 p3],phase_labels,'Location','northeast');
end
saveas(gcf,fullfile(output_folder,'Abnormal_Subplot_2.png'));

% Image 3 → Models 6-7
figure('Position',[100 80 1200 700]);
for k=6:7
    subplot(2,1,k-5); hold on; grid on;
    p1=plot(t,models{k}(:,1),'r');
    p2=plot(t,models{k}(:,2),'g');
    p3=plot(t,models{k}(:,3),'b');
    title(model_names{k},'FontWeight','bold');
    xlabel('Time (s)'); ylabel('Voltage (V)');
    legend([p1 p2 p3],phase_labels,'Location','northeast');
end
saveas(gcf,fullfile(output_folder,'Abnormal_Subplot_3.png'));
